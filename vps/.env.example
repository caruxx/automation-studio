APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
POSTGRES_PASSWORD=replace-with-a-long-random-password
ACCESS_TOKEN_EXPIRE_MINUTES=60
MFA_REQUIRED=true
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ORIGINS=https://studio.example.com
YOUTUBE_OAUTH_REDIRECT_URI=https://studio.example.com/api/oauth/callback
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15
AUTH_LOGIN_IP_MAX_ATTEMPTS=20
AUTH_LOGIN_IP_WINDOW_SECONDS=300
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=10
AUTH_LOGIN_EMAIL_WINDOW_SECONDS=900
BCRYPT_ROUNDS=12
BCRYPT_REHASH_ON_LOGIN=true
TOKEN_ACTIVE_KEY_ID=k1
TOKEN_LOCAL_KEYRING_FILE=/etc/automation-studio/keyring.json
# Optional AWS KMS configuration. When set, this takes precedence over the local file.
# TOKEN_KMS_REGION=ap-northeast-1
# TOKEN_KMS_DATA_KEYS_JSON={"replace-with-kms-key-id":"replace-with-base64-kms-ciphertext"}
# Direct JSON is supported as a fallback, but a root-owned 0600 file is recommended.
# TOKEN_LOCAL_KEYRING_JSON={"k1":"replace-with-base64-32-byte-key"}
