          "python3",
          "app_video_edit.py",
          "{operation}",
          "--params",
          "{params}"
        ]
      },
      "api": {
        "method": "POST",
        "path": "/api/video-edit/run",
        "body": {
          "operation": "{operation}",
          "input_path": "{input_path}",
