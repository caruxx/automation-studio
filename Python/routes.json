        "vol作成",
        "フォルダ作成",
        "volを作って"
      ],
      "description": "指定公開日の動画フォルダを作成",
      "api": {
        "method": "POST",
        "path": "/api/videos/create",
        "body": {
          "publish_date": "{publish_date}"
        }
      },
      "prefer": "api",
      "via_api_safe": true,
      "requires_vol": false,
      "parallelism": {
        "scope": "per-channel",
        "max_parallel": 1
      }
    },
