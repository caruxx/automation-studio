{
  "schema_version": 1,
  "workflow_version": "2026-10-25.1",
  "description": "工程・資源・終了理由の定義の正本。stage_order は新しい工程名。コードの工程名切替は段階 2b で行い、stage_aliases で旧名を対応付ける。 soft_depends_on は「完了または確定失敗まで待つ」依存（localization の失敗は upload を止めない現行仕様）。",
  "exit_reasons": [
    {
      "reason": "ok",
      "exit_code": 0,
      "status": "done",
      "retryable": false,
      "needs_human": false
    },
    {
      "reason": "failed",
      "exit_code": 1,
      "status": "failed",
      "retryable": false,
      "needs_human": false
    },
    {
      "reason": "usage",
      "exit_code": 2,
      "status": "usage",
      "retryable": false,
      "needs_human": true
    },
    {
      "reason": "unattended_login",
      "exit_code": 75,
      "status": "failed",
      "retryable": false,
      "needs_human": true
    },
    {
      "reason": "retryable",
      "exit_code": 76,
      "status": "failed",
      "retryable": true,
      "needs_human": false
    },
    {
      "reason": "quota_exhausted",
      "exit_code": 77,
      "status": "failed",
      "retryable": false,
      "needs_human": false,
      "retry_after_sec": 86400
    },
    {
      "reason": "preflight_fail",
      "exit_code": 78,
      "status": "failed",
      "retryable": false,
      "needs_human": true
    },
    {
      "reason": "selection_pending",
      "exit_code": 79,
      "status": "blocked",
      "retryable": false,
      "needs_human": false
    }
  ],
  "stage_order": [
    "suno",
    "select",
    "rename",
    "bgimage",
    "composite",
    "render",
    "qa",
    "meta",
    "localization",
    "thumbnail",
    "upload",
    "publish_verify"
  ],
  "stage_aliases": {
    "psd_composite": "composite",
    "export": "render",
    "premiere": null
  },
  "resources": [
    {
      "id": "suno",
      "scope": "machine",
      "capacity": 1,
      "note": "SUNO のブラウザ操作は同時 1"
    },
    {
      "id": "render",
      "scope": "machine",
      "capacity": 1,
      "note": "ffmpeg 書き出し"
    },
    {
      "id": "composite",
      "scope": "machine",
      "capacity": 1,
      "note": "Pillow 合成（routes.json の psd と同じ）"
    },
    {
      "id": "image_gen",
      "scope": "global",
      "capacity": 2
    },
    {
      "id": "llm",
      "scope": "global",
      "capacity": 3
    },
    {
      "id": "upload",
      "scope": "channel",
      "capacity": 1,
      "note": "YouTube API はチャンネル単位で直列"
    }
  ],
  "stages": [
    {
      "id": "suno",
      "depends_on": [],
      "executor": "mac",
      "resources": [
        "suno"
      ],
      "timeout_seconds": 3600,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 600
      },
      "done_validator": "suno_done"
    },
    {
      "id": "select",
      "depends_on": [
        "suno"
      ],
      "executor": "mac",
      "resources": [
        "llm"
      ],
      "timeout_seconds": 600,
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "done_validator": "selection_processed"
    },
    {
      "id": "rename",
      "depends_on": [
        "select"
      ],
      "executor": "mac",
      "resources": [],
      "timeout_seconds": 1800,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 60
      },
      "done_validator": "rename_done"
    },
    {
      "id": "bgimage",
      "depends_on": [
        "rename"
      ],
      "executor": "mac",
      "resources": [
        "image_gen"
      ],
      "timeout_seconds": 1800,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 120
      },
      "done_validator": "bgimage_done"
    },
    {
      "id": "composite",
      "depends_on": [
        "bgimage"
      ],
      "executor": "mac",
      "resources": [
        "composite"
      ],
      "timeout_seconds": 600,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 30
      },
      "done_validator": "composite_done"
    },
    {
      "id": "render",
      "depends_on": [
        "composite",
        "rename"
      ],
      "executor": "mac",
      "resources": [
        "render"
      ],
      "timeout_seconds": 7200,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 300
      },
      "done_validator": "export_done"
    },
    {
      "id": "qa",
      "depends_on": [
        "render"
      ],
      "executor": "mac",
      "resources": [],
      "timeout_seconds": 600,
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "done_validator": "qa_done"
    },
    {
      "id": "meta",
      "depends_on": [
        "rename",
        "qa"
      ],
      "executor": "mac",
      "resources": [
        "llm"
      ],
      "timeout_seconds": 900,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 60
      },
      "done_validator": "meta_done"
    },
    {
      "id": "localization",
      "depends_on": [
        "meta"
      ],
      "executor": "mac",
      "resources": [
        "llm"
      ],
      "timeout_seconds": 900,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 60
      },
      "done_validator": "localization_done"
    },
    {
      "id": "thumbnail",
      "depends_on": [
        "composite",
        "meta"
      ],
      "executor": "mac",
      "resources": [],
      "timeout_seconds": 1800,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 120
      },
      "done_validator": "thumbnail_done"
    },
    {
      "id": "upload",
      "depends_on": [
        "qa",
        "meta",
        "thumbnail"
      ],
      "executor": "mac",
      "resources": [
        "upload"
      ],
      "timeout_seconds": 3600,
      "retry": {
        "max_attempts": 2,
        "backoff_seconds": 600
      },
      "done_validator": "upload_done",
      "soft_depends_on": [
        "localization"
      ]
    },
    {
      "id": "publish_verify",
      "depends_on": [
        "upload"
      ],
      "executor": "vps",
      "resources": [],
      "timeout_seconds": 600,
      "retry": {
        "max_attempts": 3,
        "backoff_seconds": 900
      },
      "done_validator": "publish_verified"
    }
  ]
}
